# .env.example — docs-drift-detector (docs-drift-detector)
# Copy to .env and fill in real values. .env is git-ignored.

# Gemini API (OpenAI-compatible endpoint) or local Ollama.
DRIFT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DRIFT_API_KEY=
DRIFT_MODEL=gemma-4-31b-it

# If the model rejects or ignores the system role, set this to true so the
# system prompt gets folded into the user message.
DRIFT_FOLD_SYSTEM=false

# LLM behaviour
DRIFT_THRESHOLD=0.6
DRIFT_IMAGE_COUNT_CAP=10
DRIFT_IMAGE_SIZE_CAP_BYTES=1572864

# Uncomment for fully local / offline runs with Ollama.
# DRIFT_BASE_URL=http://localhost:11434/v1
# DRIFT_MODEL=<gemma 4 E4B tag>
